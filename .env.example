BVH_DOWNLOAD_TIMEOUT_SECONDS=30
BVH_MAX_FILE_SIZE_MB=100
BVH_MINIO_ALLOWED_HOSTS=minio.example.com
BVH_CALLBACK_ALLOWED_HOSTS=backend.example.com
BVH_CALLBACK_TOKEN=shared-secret-agreed-with-backend
# 默认自动使用 Python 包内的 src/bvh_processing/vendor/whole_body_tracking
# 如需覆盖，可设置 BVH_WBT_PROJECT_ROOT=/other/whole_body_tracking
BVH_WBT_PYTHON=/opt/isaaclab/bin/python
BVH_WBT_TASK=Tracking-Flat-G1-Wo-State-Estimation-v0
BVH_WBT_MUJOCO_XML=source/whole_body_tracking/whole_body_tracking/assets/unitree_description/mjcf/g1.xml
BVH_TRAIN_WORKSPACE_ROOT=/tmp/bvh-processing-training
BVH_TRAIN_MAX_CONCURRENCY=1
BVH_TRAIN_TIMEOUT_SECONDS=604800
BVH_RENDER_TIMEOUT_SECONDS=1800
BVH_NPZ_MAX_UNCOMPRESSED_MB=2048
